FROM postgres:15

RUN apt-get update && apt-get install -y cron && rm -rf /var/lib/apt/lists/*

COPY db_scripts/maintenance.sql /scripts/maintenance.sql
COPY db_scripts/run_maintenance.sh /scripts/run_maintenance.sh
RUN chmod +x /scripts/run_maintenance.sh

# Agenda: todo domingo às 3:00
RUN echo "0 3 * * 0 /scripts/run_maintenance.sh >> /var/log/maintenance.log 2>&1" > /etc/cron.d/maintenance
RUN chmod 0644 /etc/cron.d/maintenance

CMD ["cron", "-f"]